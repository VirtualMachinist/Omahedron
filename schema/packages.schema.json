{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://hedronite.local/omahedron/schema/packages.schema.json",
  "title": "Omahedron package map",
  "required": [
    "pin",
    "upstream_rev",
    "generated",
    "packages",
    "extra_packages"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "pin": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-.*)?$"
    },
    "upstream_rev": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated": {
      "const": false
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/package"
          },
          {
            "required": [
              "sources"
            ],
            "not": {
              "required": [
                "evidence"
              ]
            }
          }
        ]
      }
    },
    "extra_packages": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/package"
          },
          {
            "required": [
              "evidence"
            ],
            "not": {
              "required": [
                "sources"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "package": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstream",
        "status",
        "notes"
      ],
      "properties": {
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "nixpkgs",
            "pkgs",
            "host",
            "gap",
            "exclude"
          ]
        },
        "attr": {
          "type": "string",
          "minLength": 1
        },
        "availability": {
          "enum": [
            "default",
            "available"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "nixpkgs",
                  "pkgs"
                ]
              }
            }
          },
          "then": {
            "required": [
              "attr",
              "availability"
            ],
            "not": {
              "required": [
                "options"
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "attr"
                  ]
                },
                {
                  "required": [
                    "availability"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "host"
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          },
          "else": {
            "not": {
              "required": [
                "options"
              ]
            }
          }
        }
      ]
    }
  }
}
