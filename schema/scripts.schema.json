{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://hedronite.local/omahedron/schema/scripts.schema.json",
  "title": "Omahedron script ledger",
  "required": [
    "pin",
    "upstream_rev",
    "generated",
    "scripts",
    "port_scripts"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "pin": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-.*)?$"
    },
    "upstream_rev": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "generated": {
      "const": false
    },
    "scripts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "compat.schema.json"
      }
    },
    "port_scripts": {
      "type": "array",
      "items": {
        "$ref": "compat.schema.json"
      }
    }
  }
}
